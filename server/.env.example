# Copiá este archivo como ".env" dentro de la carpeta server/ y completalo.
# El archivo ".env" NO se sube a git.

# Puerto donde corre la API en tu computadora
PORT=3001

# Dirección(es) de la web que pueden llamar a la API, separadas por coma
CORS_ORIGIN=http://localhost:5173

# Mismos valores que el .env de la web (Supabase > Project Settings > API).
# Es la clave PUBLISHABLE. La clave "secret" NO hace falta y no va acá.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-clave-publishable

# ---- SOLO para el panel "Personas" (crear cuentas, cambiar contraseñas, eliminar) ----
# Es la clave SECRET de Supabase (empieza con sb_secret_). Da acceso total a tu base de datos:
#  - guardala SOLO en este archivo (server/.env) y en las variables de Vercel, como Secret
#  - NUNCA la pegues en la web (variables que empiezan con VITE_), en el chat ni en capturas
#  - si se filtra, en Supabase (Project Settings > API Keys) creá una nueva y borrá la vieja
# Sin esta clave todo funciona igual, salvo el panel "Personas".
SUPABASE_SERVICE_ROLE_KEY=
