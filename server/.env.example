# Copiá este archivo como ".env" dentro de la carpeta server/ y completalo.
# El archivo ".env" NO se sube a git.

# Puerto donde corre la API en tu computadora
PORT=3001

# Dirección(es) de la web que pueden llamar a la API, separadas por coma
CORS_ORIGIN=http://localhost:5173

# Mismos valores que el .env de la web (Supabase > Project Settings > API).
# Es la clave PUBLISHABLE. La clave "secret" NO hace falta y no va acá.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-clave-publishable
